# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "claude" or "ollama"
LLM_PROVIDER=claude

# ── Claude settings (used when LLM_PROVIDER=claude) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_FORMATTING_MODEL=claude-haiku-4-5-20251001

# ── Ollama settings (used when LLM_PROVIDER=ollama) ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_FORMATTING_MODEL=llama3.1:8b

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default dev)
DATABASE_URL=sqlite:///db/sample.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb

# ── Agent behaviour ────────────────────────────────────────────────────────────
MAX_ROWS_RETURNED=100
MAX_ERROR_RECOVERY_ATTEMPTS=3
# Set to true to allow INSERT/UPDATE/DELETE queries (dangerous!)
ALLOW_WRITE_QUERIES=false
ENABLE_PROMPT_CACHING=true
LOG_LEVEL=INFO
